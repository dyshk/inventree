# ============================================================
# InvenTree + 钉钉库存预警  通用部署配置
# ============================================================
# 换电脑部署只需改下面 4 项（其他不动）：
#   ① INVENTREE_SITE_URL       → 本机 IP 或 localhost
#   ② INVENTREE_ADMIN_PASSWORD → 管理员密码
#   ③ DINGTALK_WEBHOOK         → 你的钉钉机器人 webhook
#   ④ DINGTALK_SECRET          → 你的钉钉机器人加签 secret
#
# 改完后双击 setup.bat 即可（首次部署）
# 之后想改钉钉配置：改 .env → docker compose up -d --force-recreate
#
# 详细说明见同目录下的「配置说明.txt」
# ============================================================

# Docker Compose 项目名（别动，动了要改 docker compose 前缀）
COMPOSE_PROJECT_NAME=inventree

# InvenTree 版本标签
INVENTREE_TAG=stable

# ============================================================
# ★ ① 访问地址 ★
#   本机浏览器访问: http://localhost
#   局域网其他电脑访问: 先 ipconfig 查本机 IP（192.168.x.x），填 http://192.168.x.x
#   setup.bat 会自动检测并提醒改这里
# ============================================================
INVENTREE_SITE_URL=http://localhost

# 容器内部端口（别动）
INVENTREE_WEB_PORT=8000

# 对外发布端口（80/443 被占用时改 8080/8443，此时访问地址要带端口如 http://192.168.x.x:8080）
INVENTREE_HTTP_PORT=80
INVENTREE_HTTPS_PORT=443

# 代理转发（别动）
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

# ============================================================
# ★ CSRF 信任域名（通用配置，解决登录 403）
#   逗号分隔，把所有可能访问的地址都列进去
#   Django 会自动把 SITE_URL 加进来，但这里显式列全更稳
#   换电脑部署时，把 INVENTREE_SITE_URL 里的 IP 也加进来
#   例如: http://192.168.1.100
# ============================================================
INVENTREE_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://0.0.0.0

# 日志级别（调试时改 DEBUG）
INVENTREE_LOG_LEVEL=WARNING

# 启用钉钉插件
INVENTREE_PLUGINS_ENABLED=True

# 自动迁移（仅用于 django-q 定时任务，首次部署仍需手动迁移，setup.bat 已处理）
INVENTREE_AUTO_UPDATE=True

# ============================================================
# ★ ② 管理员账号 ★
#   首次部署 setup.bat 会自动创建
#   忘了密码可: docker exec inventree-server python /home/inventree/src/backend/InvenTree/manage.py changepassword admin
# ============================================================
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_PASSWORD=admin123456
INVENTREE_ADMIN_EMAIL=admin@localhost

# 数据库（别动，postgresql + named volume 已持久化）
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=inventree_db_user
INVENTREE_DB_PASSWORD=ChangeMe_StrongPassword_2026

# Redis 缓存（别动）
INVENTREE_CACHE_ENABLED=True
INVENTREE_CACHE_HOST=inventree-cache
INVENTREE_CACHE_PORT=6379

# Gunicorn 超时
INVENTREE_GUNICORN_TIMEOUT=90

# ============================================================
# ★ ③ ④ 钉钉机器人 ★
#   步骤：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
#   安全设置选「加签」，复制 Webhook URL 和加签 secret 填下面
#   未配置时脚本/插件会打印警告但不报错
# ============================================================
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
